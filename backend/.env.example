# Legal Lens - Environment Variables (example)
# Copy this file to backend/.env and fill in real values before deploying
# anywhere beyond a local demo. Nothing here is currently read from the
# environment by the app (see backend/app/core/config.py) - this file
# documents the intended configuration surface for the next milestone.

# --- Database (currently hardcoded to local SQLite in core/config.py) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/legallens

# --- Auth (not yet wired - see backend/app/core/security.py) ---
# JWT_SECRET_KEY=replace-with-a-real-random-secret
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60

# --- CORS ---
# ALLOWED_ORIGINS=http://localhost:8000

# --- Object storage (not yet wired - local disk is used today) ---
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=legallens-storage
