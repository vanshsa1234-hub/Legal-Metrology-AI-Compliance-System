# Legal Lens - Environment Variables (example)
# Copy this file to backend/.env and fill in real values before deploying
# anywhere beyond a local demo. Every variable below is genuinely read
# by the app (see backend/app/core/config.py and the services it
# points to) - none of this is aspirational. Everything is optional:
# leaving a section commented out falls back to a zero-setup local
# default (SQLite, local disk, inline task execution, retrieval-only
# RAG), documented next to each one. See docs/ROADMAP.md for what
# each phase actually built.

# --- Database (Phase 5) ---
# Unset: SQLite file at backend/legallens.db.
# DATABASE_URL=postgresql://legallens:legallens@localhost:5432/legallens

# --- Auth (Phase 1) ---
# Required in any real deployment; the fallback dev secret in
# core/config.py logs a loud warning on startup if left unset.
JWT_SECRET_KEY=replace-with-a-real-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Background processing (Phase 4) ---
# Unset: /process runs inline in the request (no Celery worker needed).
# REDIS_URL=redis://localhost:6379/0

# --- Object storage (Phase 6) ---
# Unset: local disk under storage/ (served via the /uploads static mount).
# S3_BUCKET=legallens
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# --- Legal RAG (Phase 7, stretch) ---
# Unset: /api/rag/resolve still returns retrieved rules, just no
# generated answer (see backend/app/services/rag_service.py).
# ANTHROPIC_API_KEY=

# --- CORS ---
# ALLOWED_ORIGINS=http://localhost:8000
